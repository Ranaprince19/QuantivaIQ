   "source": [
    "# QuantivaIQ Analytics Notebook\n",
    "\n",
    "Welcome to the exploratory data analysis notebook for QuantivaIQ. This notebook is intended to interact with the database directly to inspect the results of the ETL pipelines, the live data simulator, and the machine learning models."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import sys\n",
    "import os\n",
    "\n",
    "# Add the parent directory to the Python path to import our modules\n",
    "sys.path.append(os.path.abspath(os.path.join('..')))\n",
    "\n",
    "from python.utils import fetch_data\n",
    "\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams['figure.figsize'] = (10, 6)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Quick Data Health Check"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "tables = ['customers', 'products', 'orders', 'order_items', 'payments', 'refunds', 'fraud_logs', 'customer_segments']\n",
    "counts = {}\n",
    "for table in tables:\n",
    "    try:\n",
    "        count = fetch_data(f\"SELECT COUNT(*) FROM {table}\").iloc[0,0]\n",
    "        counts[table] = count\n",
    "    except:\n",
    "        counts[table] = \"Error/Table Missing\"\n",
    "\n",
    "pd.DataFrame(list(counts.items()), columns=['Table', 'Row Count'])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. RFM Segment Distribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "rfm_df = fetch_data(\"SELECT segment_name, COUNT(*) as customer_count FROM customer_segments GROUP BY segment_name\")\n",
    "if not rfm_df.empty:\n",
    "    sns.barplot(data=rfm_df, x='customer_count', y='segment_name', palette='viridis')\n",
    "    plt.title('Customer Distribution by RFM Segment')\n",
    "    plt.show()"
   ]
  }
 ],
