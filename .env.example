# QuantivaIQ — Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ─── Database Configuration ─────────────────────────────────────────────────
# Supported drivers: postgres, sqlite
DB_DRIVER=postgres
# Use localhost when connecting from your host machine (Power BI Desktop or local psql client).
# Use postgres when running inside Docker Compose so containers can resolve the database service.
# For Docker Compose, set DB_HOST=postgres inside container services.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantivaiq
DB_USER=postgres
DB_PASSWORD=postgres
# For local SQLite fallback, use:
# DB_DRIVER=sqlite
# SQLITE_DB_PATH=quantivaiq.db

# ─── Simulation Configuration ────────────────────────────────────────────────
# How many seconds between each live data generation cycle
SIMULATION_INTERVAL_SECONDS=5

# ─── Data Scale Configuration ────────────────────────────────────────────────
NUM_CUSTOMERS=5000
NUM_PRODUCTS=500
NUM_ORDERS=50000

# ─── ML Configuration ────────────────────────────────────────────────────────
FRAUD_CONTAMINATION_RATE=0.02
CHURN_THRESHOLD_DAYS=90
RFM_SCORE_BINS=5
